# Required: secret the Tauri client must send as X-API-Key header
API_SECRET_KEY=change_me

# Gemini API key (primary summary provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional fallback summary providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Database path (default used by Docker)
DATABASE_PATH=/app/data/meeting_minutes.db