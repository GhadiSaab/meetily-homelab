# Required: secret the Tauri client must send as X-API-Key header
# The web UI also needs this as NEXT_PUBLIC_API_KEY (set at Docker build time)
API_SECRET_KEY=change_me

# Gemini API key (primary summary provider)
# Falls back to this env var automatically if not saved via the web UI settings page
GEMINI_API_KEY=your_gemini_api_key_here

# Optional fallback summary providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Database path (default used by Docker)
DATABASE_PATH=/app/data/meeting_minutes.db

# Web UI: public-facing backend URL (used by the browser for client-side API calls)
# Must be reachable from the user's browser (not a container-internal address)
BACKEND_PUBLIC_URL=https://meetily-api.yourdomain.com

# Port overrides (optional)
# APP_PORT=5167
# WEB_PORT=3119